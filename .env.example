# Application Environment
NAUKRI_AGENT_APP_ENV=development
NAUKRI_AGENT_APP_HOST=127.0.0.1
NAUKRI_AGENT_APP_PORT=8000

# Runtime Environment (local_windows for V1, cloud for future deployment)
NAUKRI_AGENT_RUNTIME_ENVIRONMENT=local_windows

# Database Configuration
# For local development: sqlite:///./data/naukri_agent.db
# For cloud deployment: postgresql://user:password@host:port/database
NAUKRI_AGENT_DATABASE_URL=sqlite:///./data/naukri_agent.db

# API Keys (required for AI functionality)
NAUKRI_AGENT_GEMINI_API_KEY=your_gemini_api_key_here

# Logging Configuration
NAUKRI_AGENT_LOG_LEVEL=INFO

# Frontend Configuration
# Single URL for legacy compatibility
NAUKRI_AGENT_FRONTEND_URL=http://127.0.0.1:5173
# Comma-separated list for CORS (multiple origins for production)
NAUKRI_AGENT_FRONTEND_ORIGINS=http://127.0.0.1:5173

# Storage Directories
NAUKRI_AGENT_RESUME_STORAGE_DIR=data/resume
NAUKRI_AGENT_DATA_DIR=data
NAUKRI_AGENT_LOG_DIR=data/logs
NAUKRI_AGENT_BROWSER_USER_DATA_DIR=.agent/browser_session

# Application Limits
NAUKRI_AGENT_MAX_RESUME_FILE_SIZE_BYTES=10485710
NAUKRI_AGENT_MIN_RESUME_TEXT_CHARS=80

# AI Configuration
NAUKRI_AGENT_GEMINI_MODEL=gemini-2.0-flash
NAUKRI_AGENT_PROFILE_EXTRACTION_RETRIES=1
NAUKRI_AGENT_PROFILE_EXTRACTION_MAX_CHARS=12000
NAUKRI_AGENT_GEMINI_TIMEOUT_SECONDS=20
NAUKRI_AGENT_GEMINI_REQUEST_RETRIES=2
NAUKRI_AGENT_AI_CACHE_ENABLED=true

# Browser Configuration
NAUKRI_AGENT_BROWSER_TYPE=chrome

# Scheduler Configuration
NAUKRI_AGENT_SCHEDULER_ENABLED=true
NAUKRI_AGENT_SCHEDULER_INTERVAL_MINUTES=60
NAUKRI_AGENT_SCHEDULER_MAX_INSTANCES=1
