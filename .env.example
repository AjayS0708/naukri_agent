APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/naukri_agent.db
GEMINI_API_KEY=your_gemini_api_key_here
LOG_LEVEL=INFO
FRONTEND_URL=http://127.0.0.1:5173
RESUME_STORAGE_DIR=data/resume
MAX_RESUME_FILE_SIZE_BYTES=10485710
MIN_RESUME_TEXT_CHARS=80
GEMINI_MODEL=gemini-2.0-flash
PROFILE_EXTRACTION_RETRIES=1
PROFILE_EXTRACTION_MAX_CHARS=12000
GEMINI_TIMEOUT_SECONDS=20
GEMINI_REQUEST_RETRIES=2
AI_CACHE_ENABLED=true
BROWSER_TYPE=chrome
