# Application Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Runtime Environment (local_windows for V1, cloud for future deployment)
RUNTIME_ENVIRONMENT=local_windows

# Database Configuration
# For local development: sqlite:///./data/naukri_agent.db
# For cloud deployment: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./data/naukri_agent.db

# API Keys (required for AI functionality)
GEMINI_API_KEY=your_gemini_api_key_here

# Logging Configuration
LOG_LEVEL=INFO

# Frontend Configuration
# Single URL for legacy compatibility
FRONTEND_URL=http://127.0.0.1:5173
# Comma-separated list for CORS (multiple origins for production)
FRONTEND_ORIGINS=http://127.0.0.1:5173

# Storage Directories
RESUME_STORAGE_DIR=data/resume
DATA_DIR=data
LOG_DIR=data/logs
BROWSER_USER_DATA_DIR=.agent/browser_session

# Application Limits
MAX_RESUME_FILE_SIZE_BYTES=10485710
MIN_RESUME_TEXT_CHARS=80

# AI Configuration
GEMINI_MODEL=gemini-2.0-flash
PROFILE_EXTRACTION_RETRIES=1
PROFILE_EXTRACTION_MAX_CHARS=12000
GEMINI_TIMEOUT_SECONDS=20
GEMINI_REQUEST_RETRIES=2
AI_CACHE_ENABLED=true

# Browser Configuration
BROWSER_TYPE=chrome

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_MAX_INSTANCES=1
