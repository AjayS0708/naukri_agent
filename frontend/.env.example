# Frontend Environment Configuration

# API Base URL
# Development fallback when this value is omitted: http://127.0.0.1:8000
# Production: set the public HTTPS API origin. Vite exposes VITE_ values to browsers;
# never put API keys, database credentials, cookies, session data, or private tokens here.
VITE_API_BASE_URL=http://127.0.0.1:8000
